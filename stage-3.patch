+        app.world_mut().write_message(message);
+        app.update();
+        let game = app.world().resource::<Game>();
+        assert_eq!(game.world.block([8, 101, 5]), AIR);
+        assert_eq!(total_drops(game), 1);
+        assert_eq!(
+            game.vitals.exhaustion,
+            game.survival_config.mining_exhaustion
+        );
+        assert_eq!(app.world().resource::<Messages<BlockSound>>().len(), 1);
+    }
+
+    #[test]
+    fn close_action_restores_cursor_and_only_closes_inventory() {
+        let mut game = world();
+        process_action(&mut game, &InventoryAction::Close);
+        assert_eq!(game.mode, Mode::Playing);
+        game.mode = Mode::Inventory;
+        game.inventory.cursor = Some(stack(&game, game_core::DIRT, 2));
+        process_action(&mut game, &InventoryAction::Close);
+        assert_eq!(game.mode, Mode::Playing);
+        assert!(game.inventory.cursor.is_none());
+        assert_eq!(game.inventory.hotbar[0].as_ref().unwrap().count, 2);
+        assert_eq!(total_drops(&game), 0);
+    }
+
+    #[test]
+    fn dead_screen_transition_does_not_drop_kept_full_cursor() {
+        let mut game = world();
+        game.game_rules.keep_inventory = true;
+        game.mode = Mode::Inventory;
+        fill(&mut game);
+        let cursor = stack(&game, game_core::STONE, 2);
+        game.inventory.cursor = Some(cursor.clone());
+        game.vitals.damage(
+            100.,
+            game_core::survival::DamageSource::Fall,
+            GameMode::Survival,
+            &game.survival_config,
+        );
+        assert!(game.vitals.is_dead());
+        on_death(&mut game);
+        game.screen(Mode::Dead);
+        assert_eq!(game.inventory.cursor, Some(cursor));
+        assert_eq!(total_drops(&game), 0);
+    }
+
+    #[test]
+    fn reload_preserves_ids_and_retries_rejected_live_caps_after_inventory_changes() {
+        let mut game = world();
+        let item = game.content.item_for_block(game_core::DIRT).unwrap();
+        game.inventory.cursor = Some(ItemStack::new(item, 32));
+        let source = include_str!("../../../assets/data/items.ron")
+            .replace("max_stack: 64", "max_stack: 16");
+        let mut state = FileState::default();
+        reload_file(&mut state, (None, Ok(source.clone())), |source| {
+            reload_items(&mut game, source)
+        });
+        assert!(!state.accepted);
+        assert_eq!(game.content.max_stack(item), 64);
+        game.inventory.cursor = None;
+        reload_file(&mut state, (None, Ok(source)), |source| {
+            reload_items(&mut game, source)
+        });
+        assert!(state.accepted);
+        assert_eq!(game.content.item_for_block(game_core::DIRT), Some(item));
+        assert_eq!(game.content.max_stack(item), 16);
+        reload_file(
+            &mut state,
+            (Some(PathBuf::from("missing")), Err("missing file".into())),
+            |_| panic!("нечитаемый файл не применяется"),
+        );
+        assert!(!state.accepted);
+        assert_eq!(game.content.max_stack(item), 16);
+    }
+
+    #[test]
+    fn drop_simulation_pauses_outside_playing_and_pickup_refreshes_hotbar() {
+        let mut app = App::new();
+        let mut game = world();
+        let value = stack(&game, game_core::DIRT, 4);
+        game.drops
+            .spawn(value, [8.5, 100.6, 8.5], [0.; 3], &game.drop_config);
+        let mut time = Time::<Real>::default();
+        time.advance_by(std::time::Duration::from_secs(1));
+        app.insert_resource(game)
+            .insert_resource(time)
+            .add_systems(Update, tick_drops);
+        for mode in [Mode::Inventory, Mode::Console, Mode::Dead, Mode::Paused] {
+            app.world_mut().resource_mut::<Game>().mode = mode;
+            app.update();
+            let game = app.world().resource::<Game>();
+            assert_eq!(game.drops.entities.values().next().unwrap().age, 0.);
+            assert!(game.inventory.hotbar[0].is_none());
+        }
+        app.world_mut().resource_mut::<Game>().mode = Mode::Playing;
+        app.update();
+        let game = app.world().resource::<Game>();
+        assert!(game.drops.entities.is_empty());
+        assert_eq!(game.inventory.hotbar[0].as_ref().unwrap().count, 4);
+        assert_eq!(game.hotbar[0], game_core::DIRT);
+    }
+}
diff --git a/apps/client/src/inventory_render.rs b/apps/client/src/inventory_render.rs
new file mode 100644
index 0000000..7912ecd
--- /dev/null
+++ b/apps/client/src/inventory_render.rs
@@ -0,0 +1,120 @@
+//! Визуальные сущности дропа читают готовое состояние независимой логики.
+use crate::{
+    graphics_assets::BlockIcons, item_icons::ItemIcons, session::Game, streaming::Streaming,
+};
+use bevy::prelude::*;
+use game_core::{AIR, content::ItemId};
+use std::collections::{HashMap, HashSet};
+
+#[derive(Component)]
+struct DropVisual(u64);
+
+#[derive(Default)]
+struct Cache {
+    blocks: HashMap<u8, Vec<(u8, Handle<Mesh>)>>,
+    sprites: HashMap<ItemId, Handle<StandardMaterial>>,
+    quad: Option<Handle<Mesh>>,
+}
+
+pub fn plugin(app: &mut App) {
+    app.add_systems(Update, render.after(crate::inventory_client::tick_drops));
+}
+
+#[allow(clippy::too_many_arguments)]
+fn render(
+    mut commands: Commands,
+    time: Res<Time<Real>>,
+    game: Res<Game>,
+    stream: Res<Streaming>,
+    item_icons: Res<ItemIcons>,
+    block_icons: Res<BlockIcons>,
+    mut meshes: ResMut<Assets<Mesh>>,
+    mut materials: ResMut<Assets<StandardMaterial>>,
+    mut cache: Local<Cache>,
+    mut visuals: Query<(Entity, &DropVisual, &mut Transform)>,
+) {
+    let mut present = HashSet::new();
+    for (entity, visual, mut transform) in &mut visuals {
+        let drop = game
+            .world_id
+            .as_ref()
+            .and_then(|_| game.drops.entities.get(&visual.0));
+        if let Some(drop) = drop {
+            *transform = pose(drop.id, drop.position, time.elapsed_secs());
+            present.insert(drop.id);
+        } else {
+            commands.entity(entity).despawn();
+        }
+    }
+    if game.world_id.is_none() {
+        return;
+    }
+    for drop in game.drops.entities.values() {
+        if present.contains(&drop.id) {
+            continue;
+        }
+        let parent = commands
+            .spawn((
+                DropVisual(drop.id),
+                pose(drop.id, drop.position, time.elapsed_secs()),
+                Visibility::default(),
+            ))
+            .id();
+        if let Some(block) = game.content.block_for_item(drop.stack.item) {
+            let faces = cache.blocks.entry(block).or_insert_with(|| {
+                game_render::mesh_section_with_textures(
+                    [0, 0, 0],
+                    |p| if p == [0, 0, 0] { block } else { AIR },
+                    &stream.textures,
+                )
+                .into_iter()
+                .map(|(layer, mesh)| (layer, meshes.add(mesh)))
+                .collect()
+            });
+            for (layer, mesh) in faces.iter() {
+                if let Some(material) = stream.materials.get(*layer as usize) {
+                    let child = commands
+                        .spawn((
+                            Mesh3d(mesh.clone()),
+                            MeshMaterial3d(material.clone()),
+                            Transform::from_translation(Vec3::splat(-0.5)),
+                        ))
+                        .id();
+                    commands.entity(parent).add_child(child);
+                }
+            }
+        } else {
+            let texture = item_icons.get(drop.stack.item, &game.content, &block_icons);
+            let material = cache
+                .sprites
+                .entry(drop.stack.item)
+                .or_insert_with(|| {
+                    materials.add(StandardMaterial {
+                        base_color_texture: Some(texture),
+                        alpha_mode: AlphaMode::Mask(0.05),
+                        double_sided: true,
+                        cull_mode: None,
+                        unlit: true,
+                        ..default()
+                    })
+                })
+                .clone();
+            let quad = cache
+                .quad
+                .get_or_insert_with(|| meshes.add(Rectangle::new(1., 1.)))
+                .clone();
+            let child = commands
+                .spawn((Mesh3d(quad), MeshMaterial3d(material), Transform::default()))
+                .id();
+            commands.entity(parent).add_child(child);
+        }
+    }
+}
+
+fn pose(id: u64, position: [f32; 3], seconds: f32) -> Transform {
+    Transform::from_translation(
+        Vec3::from_array(position) + Vec3::Y * (0.045 * (seconds * 2.5 + id as f32).sin()),
+    )
+    .with_rotation(Quat::from_rotation_y(seconds * 0.85 + id as f32))
+    .with_scale(Vec3::splat(0.24))
+}
diff --git a/apps/client/src/item_icons.rs b/apps/client/src/item_icons.rs
new file mode 100644
index 0000000..10a3b3f
--- /dev/null
+++ b/apps/client/src/item_icons.rs
@@ -0,0 +1,239 @@
+//! Кэш значков: исходные кубики блоков и временные рисунки новых предметов.
+use crate::{graphics_assets::BlockIcons, session::Game};
+use bevy::{
+    asset::RenderAssetUsages,
+    image::ImageSampler,
+    prelude::*,
+    render::render_resource::{Extent3d, TextureDimension, TextureFormat},
+};
+use game_core::content::{ArmorSlot, ContentRegistry, ItemId, ItemKind};
+use std::collections::HashMap;
+
+#[derive(Resource, Default)]
+pub struct ItemIcons {
+    handles: HashMap<ItemId, Handle<Image>>,
+}
+impl ItemIcons {
+    pub fn get(
+        &self,
+        item: ItemId,
+        registry: &ContentRegistry,
+        blocks: &BlockIcons,
+    ) -> Handle<Image> {
+        if let Some(block) = registry.block_for_item(item) {
+            return blocks.get(block);
+        }
+        self.handles
+            .get(&item)
+            .cloned()
+            .unwrap_or_else(|| blocks.get(0))
+    }
+}
+pub fn plugin(app: &mut App) {
+    app.init_resource::<ItemIcons>()
+        .add_systems(PreUpdate, cache_icons);
+}
+fn cache_icons(
+    mut game: ResMut<Game>,
+    mut icons: ResMut<ItemIcons>,
+    mut images: ResMut<Assets<Image>>,
+) {
+    let mut added = false;
+    for (id, definition) in game.content.iter() {
+        if game.content.block_for_item(id).is_some() || icons.handles.contains_key(&id) {
+            continue;
+        }
+        // TODO art: заменить только новые предметы; исходные PNG не изменяются.
+        let mut image = Image::new(
+            Extent3d {
+                width: 128,
+                height: 128,
+                depth_or_array_layers: 1,
+            },
+            TextureDimension::D2,
+            placeholder_pixels(&definition.id, &definition.kind),
+            TextureFormat::Rgba8UnormSrgb,
+            RenderAssetUsages::default(),
+        );
+        image.sampler = ImageSampler::linear();
+        icons.handles.insert(id, images.add(image));
+        added = true;
+    }
+    if added {
+        game.ui_dirty = true;
+    }
+}
+fn placeholder_pixels(id: &str, kind: &ItemKind) -> Vec<u8> {
+    let mut pixels = vec![0; 32 * 32 * 4];
+    for y in 3_i32..29 {
+        for x in 3_i32..29 {
+            let (inside, color): (bool, [u8; 3]) = match kind {
+                ItemKind::Tool => (
+                    ((x - y).abs() <= 2 && (10..26).contains(&x))
+                        || ((6..25).contains(&x) && (6..10).contains(&y))
+                        || ((5..9).contains(&x) && (8..16).contains(&y)),
+                    if y < 10 || x < 9 {
+                        [176, 132, 75]
+                    } else {
+                        [112, 72, 40]
+                    },
+                ),
+                ItemKind::Armor { slot } => {
+                    let inside = match slot {
+                        ArmorSlot::Head => {
+                            (7..25).contains(&x)
+                                && (6..22).contains(&y)
+                                && !(y > 12 && (11..21).contains(&x))
+                        }
+                        ArmorSlot::Chest => {
+                            ((9..23).contains(&x) && (8..26).contains(&y))
+                                || ((4..28).contains(&x) && (9..16).contains(&y))
+                        }
+                        ArmorSlot::Legs => {
+                            (8..24).contains(&x)
+                                && (6..27).contains(&y)
+                                && !(y > 12 && (14..18).contains(&x))
+                        }
+                        ArmorSlot::Feet => {
+                            ((7..13).contains(&x) || (19..25).contains(&x)) && (11..26).contains(&y)
+                                || ((5..13).contains(&x) || (17..25).contains(&x))
+                                    && (22..27).contains(&y)
+                        }
+                    };
+                    (inside, [165, 101, 65])
+                }
+                ItemKind::Food => (
+                    ((x - 16).pow(2) * 2 + (y - 17).pow(2)) < 130,
+                    [235, 218, 164],
+                ),
+                _ if id.ends_with(":stick") => (
+                    (x + y - 31).abs() <= 2 && (7..25).contains(&x),
+                    [166, 116, 65],
+                ),
+                _ if id.ends_with(":egg") => (
+                    ((x - 16).pow(2) * 2 + (y - 17).pow(2)) < 130,
+                    [235, 228, 196],
+                ),
+                _ => ((x - 16).abs() + (y - 16).abs() < 12, [66, 65, 78]),
+            };
+            if inside {
+                let offset = ((y * 32 + x) * 4) as usize;
+                for channel in 0..3 {
+                    pixels[offset + channel] =
+                        color[channel].saturating_add(if x < 15 { 18 } else { 0 });
+                }
+                pixels[offset + 3] = 255;
+            }
+        }
+    }
+    let mut output = vec![0; 128 * 128 * 4];
+    for y in 0..128 {
+        for x in 0..128 {
+            let source = ((y / 4) * 32 + x / 4) * 4;
+            let target = (y * 128 + x) * 4;
+            output[target..target + 4].copy_from_slice(&pixels[source..source + 4]);
+        }
+    }
+    output
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn new_item_art_has_transparent_margin_and_visible_silhouette() {
+        let pixels = placeholder_pixels("survival:stick", &ItemKind::Material);
+        assert_eq!(&pixels[..4], &[0, 0, 0, 0]);
+        assert!(
+            pixels
+                .as_chunks::<4>()
+                .0
+                .iter()
+                .any(|pixel| pixel[3] == 255)
+        );
+    }
+    #[test]
+    fn nonblock_icons_are_cached_across_frames() {
+        let mut app = App::new();
+        app.init_resource::<Game>()
+            .init_resource::<Assets<Image>>()
+            .init_resource::<ItemIcons>()
+            .add_systems(Update, cache_icons);
+        app.update();
+        let expected = app
+            .world()
+            .resource::<Game>()
+            .content
+            .iter()
+            .filter(|(id, _)| {
+                app.world()
+                    .resource::<Game>()
+                    .content
+                    .block_for_item(*id)
+                    .is_none()
+            })
+            .count();
+        let first = app.world().resource::<ItemIcons>().handles.clone();
+        assert!(expected > 0);
+        assert_eq!(first.len(), expected);
+        app.update();
+        let images = app.world().resource::<Assets<Image>>();
+        assert_eq!(images.len(), expected);
+        assert!(
+            images
+                .iter()
+                .all(|(_, image)| image.texture_descriptor.size.width == 128
+                    && image.texture_descriptor.size.height == 128)
+        );
+        assert_eq!(app.world().resource::<ItemIcons>().handles, first);
+    }
+    #[test]
+    fn newly_reloaded_item_requests_exactly_one_ui_refresh() {
+        let mut app = App::new();
+        app.init_resource::<Game>()
+            .init_resource::<Assets<Image>>()
+            .init_resource::<ItemIcons>()
+            .add_systems(Update, cache_icons);
+        app.update();
+        let initial_images = app.world().resource::<Assets<Image>>().len();
+        let mut source = include_str!("../../../assets/data/items.ron").to_string();
+        source.insert_str(source.rfind(']').unwrap(),
+            "(id: \"survival:ui_cache_fixture\", name: \"Тест кэша\", max_stack: 64, kind: Material),\n");
+        let mut game = app.world_mut().resource_mut::<Game>();
+        game.content = game.content.reload(&source).unwrap();
+        game.ui_dirty = false;
+        let item = game.content.find("survival:ui_cache_fixture").unwrap();
+        app.update();
+        assert!(app.world().resource::<Game>().ui_dirty);
+        assert!(
+            app.world()
+                .resource::<ItemIcons>()
+                .handles
+                .contains_key(&item)
+        );
+        assert_eq!(
+            app.world().resource::<Assets<Image>>().len(),
+            initial_images + 1
+        );
+        app.world_mut().resource_mut::<Game>().ui_dirty = false;
+        app.update();
+        assert!(!app.world().resource::<Game>().ui_dirty);
+        assert_eq!(
+            app.world().resource::<Assets<Image>>().len(),
+            initial_images + 1
+        );
+    }
+    #[test]
+    fn block_items_reuse_original_cube_handles() {
+        let registry = ContentRegistry::default();
+        let mut blocks = BlockIcons::default();
+        let mut images = Assets::<Image>::default();
+        blocks.handles = (0..17).map(|_| images.add(Image::default())).collect();
+        let icons = ItemIcons::default();
+        for (id, _) in registry.iter() {
+            if let Some(block) = registry.block_for_item(id) {
+                assert_eq!(icons.get(id, &registry, &blocks), blocks.get(block));
+            }
+        }
+    }
+}
